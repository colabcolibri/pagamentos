# Copie para .env: cp .env.example .env
# Senha do Postgres sem @, : ou /. O compose monta a DATABASE_URL com ela.

POSTGRES_USER=quitou
POSTGRES_PASSWORD=
POSTGRES_DB=quitou

# URL pública. Entra no build da imagem. Local: http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_AUTH_COOKIE_NAME=quitou_token

# Marca. Lida na subida do processo. Trocar e reiniciar, sem rebuild.
BRAND_NAME=Quitou
BRAND_TAGLINE=Pague com Pix, boleto ou cartão e acompanhe seus pedidos.
BRAND_LOGO_SRC=/brand/logo.svg
BRAND_COPYRIGHT_NAME=Quitou
BRAND_LEGAL_NAME=
BRAND_CNPJ=
BRAND_SUPPORT_EMAIL=
BRAND_CONTACT_EMAIL=
BRAND_PRIVACY_URL=
BRAND_TERMS_URL=

# Quem entra com este e-mail vira admin.
ADMIN_EMAIL=admin@example.com

# Segredo do código de acesso. Gere com: openssl rand -hex 32
ACCESS_CODE_SECRET=

# Chave opcional de criptografia em repouso (AES-256-GCM) para segredos salvos no banco.
# Se vazia, o servidor deriva a chave a partir de ACCESS_CODE_SECRET. Gere com: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Opcional: lista de hosts HTTPS permitidos para redirect_uri de clientes OAuth do MCP (separados por vírgula).
# Clientes locais (http://127.0.0.1 / http://localhost) continuam permitidos por padrão.
MCP_ALLOWED_REDIRECT_HOSTS=

# SMTP. Em dev com `docker compose --profile dev up`, use SMTP_HOST=mailpit e SMTP_PORT=1025 (UI em http://localhost:8025).
# Em produção, aponte para o seu provedor SMTP (ou configure depois pela tela /admin/setup).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=dev@example.com
EMAIL_FROM_NAME=

# Gateways. Podem ficar vazios até você salvar em Configurações.
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

TRUSTED_PROXY=1
