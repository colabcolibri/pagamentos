{
  "name": "quitou-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do Quitou - Sistema de pagamentos brasileiro",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "pnpm --filter @quitou/core test && pnpm --filter @quitou/admin test",
    "publish:core": "cd packages/core && pnpm publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4"
  },
  "lint-staged": {
    "front-pagamento/**/*.{js,jsx,ts,tsx}": [
      "node scripts/lint-staged-front.mjs eslint",
      "node scripts/lint-staged-front.mjs prettier"
    ],
    "front-pagamento/**/*.{json,md,css}": [
      "node scripts/lint-staged-front.mjs prettier"
    ]
  },
  "keywords": [
    "quitou",
    "pagamento",
    "monorepo"
  ],
  "author": "Quitou Contributors",
  "license": "MIT"
}

