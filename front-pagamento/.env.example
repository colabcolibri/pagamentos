# =============================================================================
# Quitou — variáveis de ambiente
# =============================================================================
# Copie para .env.local: cp .env.example .env.local
# Preencha os valores. Nunca commite .env.local ou arquivos com secrets.
# =============================================================================

# Postgres. Só o servidor. Nunca NEXT_PUBLIC_DATABASE_URL.
# DATABASE_URL=postgres://quitou@127.0.0.1:5435/quitou

# --- Pagar.me (obrigatório para checkout) ---
# Dashboard Pagar.me → API Keys
PAGARME_SECRET_KEY=sk_...
# Webhook: Basic Auth (usuário e senha configurados no dashboard do Pagar.me)
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_SECRET=
# sandbox | production. Omitir = production (use sandbox só em dev/preview)
# PAGARME_ENVIRONMENT=sandbox

# --- Asaas (obrigatório para checkout) ---
# Dashboard Asaas → Integrações → API
ASAAS_API_KEY=
# Token de validação do webhook (header asaas-access-token)
ASAAS_WEBHOOK_SECRET=
# sandbox | production. Omitir = production (use sandbox só em dev/preview)
# ASAAS_ENVIRONMENT=sandbox

# --- Aplicação ---
# URL pública do app. Obrigatória. Local: http://localhost:3004. Servidor: https do domínio, atrás do nginx.
NEXT_PUBLIC_APP_URL=
# Opcional: protege GET /api/products/by-price/* (integrações server-to-server).
# O checkout usa server action e não precisa desta chave no browser.
# Envie: x-api-key: <valor> ou Authorization: Bearer <valor>
# Opcional. Se vazio, a chave pode ficar em Configurações. Se preenchida, ela trava a do banco.
# PRODUCTS_BY_PRICE_API_KEY=
# Rate limit das rotas /api no middleware: em produção fica ativo. Para e2e/CI com next start, use:
# DISABLE_API_RATE_LIMIT=1
# Opcional
NEXT_PUBLIC_AUTH_COOKIE_NAME=quitou_token
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Marca da instância (lida na subida, sem rebuild) ---
BRAND_NAME=Quitou
BRAND_TAGLINE=Pague com Pix, boleto ou cartão e acompanhe seus pedidos.
BRAND_LOGO_SRC=/brand/logo.svg
BRAND_COPYRIGHT_NAME=Quitou
BRAND_LEGAL_NAME=
BRAND_CNPJ=
BRAND_SUPPORT_EMAIL=
BRAND_CONTACT_EMAIL=
BRAND_PRIVACY_URL=
BRAND_TERMS_URL=

# --- Email ---
# Dev: Mailpit. SMTP na 1025. A caixa abre em http://localhost:8025
# Produção: Resend. SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=chave da API.
# Quem recebe vê EMAIL_FROM. SMTP_USER fica "resend" e não é o remetente.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=dev@quitou.local
EMAIL_FROM_NAME=
# Quem entra com este e-mail vira admin. Troque pelo seu. Não use NEXT_PUBLIC_.
ADMIN_EMAIL=admin@quitou.local
# Segredo do HMAC do código de acesso. Só o servidor. Troque em produção.
ACCESS_CODE_SECRET=
# Chave opcional de criptografia AES-256-GCM para segredos no banco (se vazia, deriva de ACCESS_CODE_SECRET).
# SETTINGS_ENCRYPTION_KEY=
# Opcional: hosts HTTPS permitidos para redirect_uri do OAuth MCP (separados por vírgula).
# MCP_ALLOWED_REDIRECT_HOSTS=
# 1 no servidor, atrás do nginx, que reescreve X-Forwarded-For. Sem isso o rate limit ignora o header.
# TRUSTED_PROXY=1

# --- Umami (opcional). A sua instalação. Sem as duas, o script não entra na página. ---
# NEXT_PUBLIC_UMAMI_SRC=https://umami.seudominio.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# --- Google Gemini (opcional; para geração de produtos via IA) ---
# API key: https://aistudio.google.com/apikey
# Se vazio, a chave salva em Configurações vale. Se preenchida, ela trava a do banco.
# GEMINI_API_KEY=
